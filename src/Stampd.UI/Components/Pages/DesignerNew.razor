@page "/designer/new"
@page "/designer/edit/{Id:guid}"
@rendermode InteractiveServer
@inject DesignerApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@(IsEditMode ? "Edit template" : "New template") — Stampd</PageTitle>

<div class="stampd-page">
    <section class="stampd-hero">
        <h1 class="stampd-hero-title">@HeroTitle</h1>
        <p class="stampd-hero-sub">
            @if (IsEditMode)
            {
                <text>
                    The source PDF is locked at creation time. You can rename, retag roles, and
                    move/resize/add/delete fields. Save to update the template.
                </text>
            }
            else
            {
                <text>
                    Upload a PDF, define recipient roles, then click on any page to place fields.
                    Save when you're done — the template becomes available for signing requests.
                </text>
            }
        </p>
    </section>

    <DesignerAuthBar @ref="_authBar" OnTokenChanged="OnTokenChanged" />

    @if (string.IsNullOrEmpty(_token))
    {
        <section class="stampd-card">
            <p class="stampd-page-subtitle">Provide a JWT bearer token above to save templates.</p>
        </section>
    }
    else
    {
        <section class="stampd-card">
            <h2 class="stampd-card-title">1. Basics</h2>
            <div style="display:grid; grid-template-columns: 1fr 2fr; gap: 0.6rem 1rem; align-items: center; margin-top: 0.75rem;">
                <label class="signer-field-label">Name</label>
                <input class="stampd-auth-input" @bind="_name" placeholder="e.g. NDA v3" />

                <label class="signer-field-label">Description</label>
                <input class="stampd-auth-input" @bind="_description" placeholder="Optional internal description" />
            </div>
        </section>

        <section class="stampd-card">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem;">
                <h2 class="stampd-card-title" style="margin:0;">2. Roles</h2>
                <button class="stampd-btn stampd-btn--ghost" type="button" @onclick="AddRole">+ Add role</button>
            </div>
            @if (_roles.Count == 0)
            {
                <p class="stampd-page-subtitle">Add at least one role (e.g. <em>Signer</em>) — recipients will be assigned roles when a signing request is dispatched.</p>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:0.6rem;">
                    @for (var i = 0; i < _roles.Count; i++)
                    {
                        var idx = i;
                        var role = _roles[idx];
                        <div style="display:grid; grid-template-columns: 2fr 100px 1fr 80px; gap:0.5rem; align-items:center;">
                            <input class="stampd-auth-input" @bind="role.Name" placeholder="Role name" />
                            <input class="stampd-auth-input" type="number" min="1" @bind="role.RoutingOrder" />
                            <label style="display:flex; align-items:center; gap:0.4rem; font-size:0.85rem;">
                                <input type="checkbox" @bind="role.RequiresIdentityVerification" />
                                Requires identity verification
                            </label>
                            <button class="stampd-btn stampd-btn--ghost" type="button" @onclick="() => _roles.RemoveAt(idx)">Remove</button>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="stampd-card">
            <h2 class="stampd-card-title">3. PDF</h2>
            @if (IsEditMode)
            {
                <p class="stampd-page-subtitle" style="margin-top:0.5rem;">
                    The source PDF is immutable for this template.
                    @if (!string.IsNullOrEmpty(_sourcePdfSha256))
                    {
                        <text>SHA-256: <code class="stampd-code">@_sourcePdfSha256[..16]…</code></text>
                    }
                </p>
                @if (_loadingPdf)
                {
                    <p class="stampd-page-subtitle">Loading PDF…</p>
                }
            }
            else
            {
                <div style="display:flex; gap:0.75rem; align-items:center; margin-top:0.5rem; flex-wrap:wrap;">
                    <InputFile accept="application/pdf" OnChange="OnPdfPickedAsync" />
                    @if (!string.IsNullOrEmpty(_pdfFileName))
                    {
                        <span class="stampd-chip stampd-chip--accent">@_pdfFileName</span>
                    }
                    @if (_loadingPdf)
                    {
                        <span class="stampd-page-subtitle">Reading PDF…</span>
                    }
                </div>
            }
            @if (_pdfError is not null)
            {
                <div class="signer-error" style="margin-top: 0.75rem;">@_pdfError</div>
            }
        </section>

        @if (!string.IsNullOrEmpty(_pdfBase64))
        {
            <section class="stampd-card">
                <h2 class="stampd-card-title">4. Place fields</h2>
                <p class="stampd-page-subtitle" style="margin-bottom: 0.75rem;">
                    Pick a field kind, then click on the PDF to place it. Edit role / size in the
                    list below.
                </p>

                <div style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom: 0.75rem;">
                    @foreach (var kind in new[] { "Signature", "Initials", "Date", "Text", "Checkbox" })
                    {
                        <button type="button"
                                class="stampd-chip @(_activeKind == kind ? "stampd-chip--accent" : "")"
                                style="cursor:pointer;"
                                @onclick="() => _activeKind = kind">
                            @kind
                        </button>
                    }
                </div>

                <div class="designer-canvas-host" @ref="_canvasHost"></div>

                @if (_fields.Count > 0)
                {
                    <div style="margin-top: 1rem;">
                        <h3 style="font-size:0.74rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--stampd-muted); margin:0 0 0.5rem;">Placed fields</h3>
                        <div class="stampd-placed-table">
                            <div class="stampd-placed-row stampd-placed-row--head">
                                <div>#</div>
                                <div>Page</div>
                                <div>Kind</div>
                                <div>Role</div>
                                <div>Pos / size (%)</div>
                                <div></div>
                            </div>
                            @for (var i = 0; i < _fields.Count; i++)
                            {
                                var idx = i;
                                var f = _fields[idx];
                                var rowClass = "stampd-placed-row" + (_selectedFieldIndex == idx ? " stampd-placed-row--selected" : "");
                                <div class="@rowClass">
                                    <div>@(idx + 1)</div>
                                    <div>@f.PageNumber</div>
                                    <div>@f.Kind</div>
                                    <div>
                                        <select @bind="f.AssignedRoleName" class="stampd-auth-input">
                                            <option value="">(unassigned)</option>
                                            @foreach (var role in _roles.Where(r => !string.IsNullOrWhiteSpace(r.Name)))
                                            {
                                                <option value="@role.Name">@role.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div style="font-family: monospace; font-size:0.78rem;">
                                        x:@f.X.ToString("0") y:@f.Y.ToString("0") w:@f.Width.ToString("0") h:@f.Height.ToString("0")
                                    </div>
                                    <div>
                                        <button class="stampd-btn stampd-btn--ghost" type="button" title="Delete field" @onclick="() => RemoveFieldFromTableAsync(idx)">×</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="stampd-card">
                <div style="display:flex; gap:0.75rem; align-items:center;">
                    <button class="stampd-btn stampd-btn--primary"
                            type="button"
                            disabled="@(!CanSave() || _saving)"
                            @onclick="SaveAsync">
                        @(_saving ? (IsEditMode ? "Saving…" : "Saving…") : (IsEditMode ? "Save changes" : "Save template"))
                    </button>
                    <a class="stampd-btn stampd-btn--ghost" href="/designer">Cancel</a>
                </div>
                @if (_saveError is not null)
                {
                    <div class="signer-error" style="margin-top: 0.75rem;">@_saveError</div>
                }
            </section>
        }
    }
</div>

@code {
    /// <summary>Route parameter — present when the page is mounted as /designer/edit/{Id}.</summary>
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;

    private string HeroTitle =>
        IsEditMode
            ? (string.IsNullOrWhiteSpace(_name) ? "Edit template" : $"Edit template — {_name}")
            : "New template";

    private DesignerAuthBar? _authBar;
    private string _token = string.Empty;

    private string _name = string.Empty;
    private string _description = string.Empty;
    private string _pdfFileName = string.Empty;
    private string _pdfBase64 = string.Empty;
    private string? _sourcePdfSha256;

    private readonly List<DesignerRole> _roles = new() { new DesignerRole { Name = "Signer", RoutingOrder = 1 } };
    private readonly List<DesignerField> _fields = new();
    private int _nextIndex = 0;
    private string _activeKind = "Signature";

    private ElementReference _canvasHost;
    private IJSObjectReference? _canvas;
    private DotNetObjectReference<DesignerNew>? _selfRef;
    private int? _selectedFieldIndex;
    private bool _saving;
    private string? _saveError;
    private bool _loadingPdf;
    private string? _pdfError;
    private bool _editTemplateLoaded;

    private void AddRole() => _roles.Add(new DesignerRole { Name = string.Empty, RoutingOrder = _roles.Count + 1 });

    private async Task RemoveFieldFromTableAsync(int idx)
    {
        _fields.RemoveAt(idx);
        if (_selectedFieldIndex == idx) _selectedFieldIndex = null;
        else if (_selectedFieldIndex > idx) _selectedFieldIndex--;
        await SyncOverlaysAsync();
    }

    private async Task OnTokenChanged(string token)
    {
        _token = token;

        // In edit mode, the very first time we get a token, hydrate the form state
        // (name, description, roles, fields) from the server and fetch the PDF bytes
        // so the canvas can render. Subsequent token changes (re-paste, refresh) are
        // ignored — the user has already edited locally.
        if (IsEditMode && !string.IsNullOrEmpty(token) && !_editTemplateLoaded && !_loadingPdf)
        {
            await LoadExistingTemplateAsync();
        }
    }

    private async Task LoadExistingTemplateAsync()
    {
        if (Id is null) return;

        _loadingPdf = true;
        _pdfError = null;
        StateHasChanged();

        try
        {
            var detail = await Api.GetAsync(_token, Id.Value, CancellationToken.None);
            if (detail is null)
            {
                _pdfError = $"Template {Id.Value:D} not found, or token does not have permission to read it.";
                return;
            }

            // Hydrate metadata.
            _name = detail.Name;
            _description = detail.Description ?? string.Empty;
            _sourcePdfSha256 = detail.SourcePdfSha256;

            // Replace the seeded "Signer" placeholder with the actual roles.
            _roles.Clear();
            foreach (var r in detail.Roles.OrderBy(r => r.RoutingOrder))
            {
                _roles.Add(new DesignerRole
                {
                    Name = r.Name,
                    RoutingOrder = r.RoutingOrder,
                    RequiresIdentityVerification = r.RequiresIdentityVerification,
                });
            }
            if (_roles.Count == 0)
            {
                _roles.Add(new DesignerRole { Name = "Signer", RoutingOrder = 1 });
            }

            // Hydrate fields.
            _fields.Clear();
            foreach (var f in detail.Fields)
            {
                _fields.Add(new DesignerField
                {
                    Index = _nextIndex++,
                    PageNumber = f.PageNumber,
                    X = f.Bounds.X,
                    Y = f.Bounds.Y,
                    Width = f.Bounds.Width,
                    Height = f.Bounds.Height,
                    Kind = f.Kind,
                    AssignedRoleName = f.AssignedRoleName,
                    IsRequired = f.IsRequired,
                    Label = f.Label,
                });
            }

            // Pull the PDF bytes and prime the canvas.
            var pdfBytes = await Api.GetPdfAsync(_token, Id.Value, CancellationToken.None);
            if (pdfBytes is null)
            {
                _pdfError = "Failed to fetch the template's source PDF.";
                return;
            }

            _pdfFileName = $"template-{detail.Name}.pdf";
            _pdfBase64 = Convert.ToBase64String(pdfBytes);
            _editTemplateLoaded = true;

            StateHasChanged();
            await RenderCanvasAsync();
        }
        catch (Exception ex)
        {
            _pdfError = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loadingPdf = false;
            StateHasChanged();
        }
    }

    private async Task OnPdfPickedAsync(InputFileChangeEventArgs e)
    {
        _pdfError = null;
        _loadingPdf = true;
        StateHasChanged();
        try
        {
            var file = e.File;
            if (file is null)
            {
                _pdfError = "No file selected.";
                return;
            }

            // Cap at 50 MB — the WebApi enforces the same; saves us a wasted upload.
            const long MaxBytes = 50 * 1024 * 1024;
            if (file.Size > MaxBytes)
            {
                _pdfError = $"File is too large ({file.Size / 1024 / 1024} MB). Limit is 50 MB.";
                return;
            }

            using var ms = new MemoryStream();
            await using (var src = file.OpenReadStream(MaxBytes))
            {
                await src.CopyToAsync(ms);
            }

            _pdfFileName = file.Name;
            _pdfBase64 = Convert.ToBase64String(ms.ToArray());

            // Render the canvas now that we have the PDF.
            StateHasChanged();
            await RenderCanvasAsync();
        }
        catch (Exception ex)
        {
            _pdfError = $"PDF read failed: {ex.Message}";
        }
        finally
        {
            _loadingPdf = false;
            StateHasChanged();
        }
    }

    private async Task RenderCanvasAsync()
    {
        _canvas ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/designer-canvas.js");
        _selfRef ??= DotNetObjectReference.Create(this);
        await _canvas.InvokeVoidAsync("render", _canvasHost, _pdfBase64, _selfRef);
        await SyncOverlaysAsync();
    }

    private async Task SyncOverlaysAsync()
    {
        if (_canvas is null) return;
        await _canvas.InvokeVoidAsync("syncOverlays", _canvasHost, _fields.Select(f => new
        {
            pageNumber = f.PageNumber,
            x = f.X,
            y = f.Y,
            width = f.Width,
            height = f.Height,
            kind = f.Kind,
            label = f.Label,
            assignedRoleName = f.AssignedRoleName,
        }).ToArray(), _selectedFieldIndex);
    }

    [JSInvokable]
    public async Task OnFieldSelected(int index)
    {
        if (index >= 0 && index < _fields.Count)
        {
            _selectedFieldIndex = index;
            await InvokeAsync(StateHasChanged);
            await SyncOverlaysAsync();
        }
    }

    [JSInvokable]
    public async Task OnFieldMoved(int index, double x, double y)
    {
        if (index < 0 || index >= _fields.Count) return;
        _fields[index].X = x;
        _fields[index].Y = y;
        _selectedFieldIndex = index;
        await InvokeAsync(StateHasChanged);
        await SyncOverlaysAsync();
    }

    [JSInvokable]
    public async Task OnFieldResized(int index, double x, double y, double width, double height)
    {
        if (index < 0 || index >= _fields.Count) return;
        _fields[index].X = x;
        _fields[index].Y = y;
        _fields[index].Width = width;
        _fields[index].Height = height;
        _selectedFieldIndex = index;
        await InvokeAsync(StateHasChanged);
        await SyncOverlaysAsync();
    }

    [JSInvokable]
    public async Task OnFieldDeleted(int index)
    {
        if (index < 0 || index >= _fields.Count) return;
        _fields.RemoveAt(index);
        _selectedFieldIndex = null;
        await InvokeAsync(StateHasChanged);
        await SyncOverlaysAsync();
    }

    [JSInvokable]
    public async Task OnSelectionCleared()
    {
        _selectedFieldIndex = null;
        await InvokeAsync(StateHasChanged);
        await SyncOverlaysAsync();
    }

    [JSInvokable]
    public async Task OnPageClick(int pageNo, double xPct, double yPct)
    {
        // Reasonable defaults per kind; the canvas overlay enforces a min height.
        var (w, h) = _activeKind switch
        {
            "Signature" => (28.0, 6.0),
            "Initials"  => (10.0, 5.0),
            "Date"      => (12.0, 3.5),
            "Checkbox"  => (3.0, 3.0),
            _           => (20.0, 4.0),
        };

        _fields.Add(new DesignerField
        {
            Index = _nextIndex++,
            PageNumber = pageNo,
            X = Math.Round(xPct, 2),
            Y = Math.Round(yPct, 2),
            Width = w,
            Height = h,
            Kind = _activeKind,
            AssignedRoleName = _roles.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.Name))?.Name,
        });
        // Auto-select the newly-placed field so the user can immediately move/resize it.
        _selectedFieldIndex = _fields.Count - 1;
        await InvokeAsync(StateHasChanged);
        await SyncOverlaysAsync();
    }

    private bool CanSave()
        => !string.IsNullOrWhiteSpace(_name)
        && !string.IsNullOrEmpty(_pdfBase64)
        && _roles.Any(r => !string.IsNullOrWhiteSpace(r.Name));

    private async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;
        try
        {
            var validRoles = _roles.Where(r => !string.IsNullOrWhiteSpace(r.Name))
                                   .Select(r => new TemplateRoleDto(r.Name.Trim(), r.RoutingOrder, r.RequiresIdentityVerification))
                                   .ToArray();

            var fieldsDto = _fields.Select(f => new TemplateFieldDto(
                PageNumber: f.PageNumber,
                Bounds: new ApiPercentageRect(f.X, f.Y, f.Width, f.Height),
                Kind: f.Kind,
                AssignedRoleName: f.AssignedRoleName,
                IsRequired: f.IsRequired,
                Label: f.Label)).ToArray();

            if (IsEditMode && Id is { } templateId)
            {
                var body = new UpdateTemplateRequest(
                    Name: _name.Trim(),
                    Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    Roles: validRoles,
                    Fields: fieldsDto);

                var (ok, err) = await Api.UpdateAsync(_token, templateId, body, CancellationToken.None);
                if (!ok)
                {
                    _saveError = err ?? "Update failed";
                    return;
                }

                // Use ?updated= so the list page can show "Template updated" instead of "saved".
                Navigation.NavigateTo($"/designer?updated={Uri.EscapeDataString(_name.Trim())}");
            }
            else
            {
                var body = new CreateTemplateRequest(
                    Name: _name.Trim(),
                    Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    SourcePdfBase64: _pdfBase64,
                    Roles: validRoles,
                    Fields: fieldsDto);

                var (ok, id, err) = await Api.CreateAsync(_token, body, CancellationToken.None);
                if (!ok)
                {
                    _saveError = err ?? "Save failed";
                    return;
                }
                // Pass the saved template name through the query so the list page can
                // surface a confirmation toast. Encoded so names with spaces / specials
                // round-trip safely.
                Navigation.NavigateTo($"/designer?saved={Uri.EscapeDataString(_name.Trim())}");
            }
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_canvas is not null) try { await _canvas.DisposeAsync(); } catch { }
        _selfRef?.Dispose();
    }
}
