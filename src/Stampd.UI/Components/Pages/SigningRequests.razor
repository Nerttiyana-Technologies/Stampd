@page "/designer/requests"
@rendermode InteractiveServer
@inject DesignerApiClient Api
@inject IConfiguration Config
@inject IHostEnvironment HostEnv

<PageTitle>Signing requests — Stampd</PageTitle>

<div class="stampd-page">
    <section class="stampd-hero">
        <h1 class="stampd-hero-title">Signing requests</h1>
        <p class="stampd-hero-sub">
            Workflows you've dispatched. Once every recipient signs, the signed PDF is sealed
            and downloadable here. Newest first.
        </p>
    </section>

    @if (!AutoAuth)
    {
        <DesignerAuthBar @ref="_authBar" OnTokenChanged="OnTokenChanged" />
    }

    <section class="stampd-card">
        @if (_loading)
        {
            <p class="stampd-page-subtitle">Loading…</p>
        }
        else if (!AutoAuth && string.IsNullOrEmpty(_token))
        {
            <p class="stampd-page-subtitle">Enter a JWT bearer token above to list signing requests.</p>
        }
        else if (_page is null)
        {
            <div class="signer-error">Failed to load signing requests.</div>
        }
        else if (_page.Items.Count == 0)
        {
            <p class="stampd-page-subtitle">
                No signing requests yet. Open a template in the
                <a href="/designer">designer</a> and click <strong>Send</strong> to dispatch one.
            </p>
        }
        else
        {
            <div class="stampd-template-table">
                <div class="stampd-request-row stampd-template-head">
                    <div>Subject / Template</div>
                    <div>Recipient</div>
                    <div>Status</div>
                    <div>Dispatched</div>
                    <div>Signed PDF</div>
                </div>
                @foreach (var r in _page.Items)
                {
                    var firstRecipient = r.Recipients.FirstOrDefault();
                    var isCompleted = string.Equals(r.Status, "Completed", StringComparison.OrdinalIgnoreCase);
                    <div class="stampd-request-row">
                        <div>
                            <div style="font-weight:600;">@r.Subject</div>
                            @if (!string.IsNullOrWhiteSpace(r.TemplateName))
                            {
                                <div style="font-size:0.82rem; color: var(--stampd-muted);">@r.TemplateName</div>
                            }
                        </div>
                        <div style="font-size:0.86rem;">
                            @if (firstRecipient is not null)
                            {
                                <div>@firstRecipient.Name</div>
                                <div style="font-size:0.78rem; color: var(--stampd-muted);">@firstRecipient.Email</div>
                            }
                            @if (r.Recipients.Count > 1)
                            {
                                <a href="@($"/designer/requests/{r.Id}")"
                                   style="font-size:0.75rem; color: var(--stampd-accent); margin-top:2px; display:inline-block; text-decoration:none;"
                                   title="See all @r.Recipients.Count recipients and their statuses">
                                    +@(r.Recipients.Count - 1) more → see all
                                </a>
                            }
                        </div>
                        <div>
                            <span class="stampd-chip @StatusChipClass(r.Status)">@r.Status</span>
                        </div>
                        <div style="font-size:0.85rem; color: var(--stampd-muted);">
                            @r.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <div style="display:flex; gap:0.4rem; justify-content:flex-end; align-items:center;">
                            <a class="stampd-btn stampd-btn--ghost"
                               href="@($"/designer/requests/{r.Id}")"
                               title="See per-recipient status, timestamps, and audit trail">
                                Details
                            </a>
                            @if (isCompleted)
                            {
                                <a class="stampd-btn stampd-btn--primary"
                                   href="@SignedDocumentUrl(r.Id)"
                                   target="_blank"
                                   rel="noopener"
                                   title="Open the sealed PDF in a new tab">
                                    Open
                                </a>
                            }
                            else if (firstRecipient?.AccessUrl is { } url)
                            {
                                <a class="stampd-btn stampd-btn--ghost"
                                   href="@url"
                                   target="_blank"
                                   rel="noopener"
                                   title="Open the recipient signing link">
                                    Recipient link
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination footer (v1.3 #158) -->
            <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--stampd-border);">
                <div style="display:flex; align-items:center; gap:0.6rem; font-size:0.85rem; color: var(--stampd-muted);">
                    <span>@RowRangeLabel()</span>
                    <span style="opacity:0.5;">·</span>
                    <label for="page-size" style="font-size:0.85rem;">Per page</label>
                    <select id="page-size"
                            class="stampd-auth-input"
                            style="width:auto; padding:0.3rem 0.5rem; font-size:0.85rem;"
                            value="@_pageSize"
                            @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>

                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <button type="button"
                            class="stampd-btn stampd-btn--ghost"
                            disabled="@(_page.Page <= 1)"
                            @onclick="PrevPageAsync">
                        ← Previous
                    </button>
                    <span style="font-size:0.85rem; color: var(--stampd-muted); padding:0 0.5rem;">
                        Page <strong style="color: var(--stampd-text);">@_page.Page</strong> of <strong style="color: var(--stampd-text);">@_page.TotalPages</strong>
                    </span>
                    <button type="button"
                            class="stampd-btn stampd-btn--ghost"
                            disabled="@(_page.Page >= _page.TotalPages)"
                            @onclick="NextPageAsync">
                        Next →
                    </button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    // Page-size choices kept narrow on purpose — 10/25/50/100 covers scanability through
    // power use without offering a footgun (the API caps at 200 regardless).
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private DesignerAuthBar? _authBar;
    private string _token = string.Empty;
    private SigningRequestListPage? _page;
    private int _pageNumber = 1;
    private int _pageSize = 25;
    private bool _loading;

    private bool AutoAuth => HostEnv.IsDevelopment();

    protected override async Task OnInitializedAsync()
    {
        if (AutoAuth)
        {
            await LoadAsync();
        }
    }

    private async Task OnTokenChanged(string token)
    {
        _token = token;
        if (string.IsNullOrEmpty(token))
        {
            _page = null;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _page = await Api.ListSigningRequestsAsync(
                _token,
                templateId: null,
                _pageNumber,
                _pageSize,
                CancellationToken.None);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrevPageAsync()
    {
        if (_page is null || _page.Page <= 1) return;
        _pageNumber = _page.Page - 1;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page is null || _page.Page >= _page.TotalPages) return;
        _pageNumber = _page.Page + 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newSize) || newSize <= 0) return;
        // Reset to page 1 when the window size changes — otherwise asking for page 8
        // at 100/page lands on a phantom page when you switch down to 10/page.
        _pageSize = newSize;
        _pageNumber = 1;
        await LoadAsync();
    }

    private string RowRangeLabel()
    {
        if (_page is null || _page.Total == 0) return "No results";
        var first = ((_page.Page - 1) * _page.PageSize) + 1;
        var last = Math.Min(first + _page.Items.Count - 1, _page.Total);
        return $"Showing {first}–{last} of {_page.Total}";
    }

    /// <summary>
    /// Composes the URL for the management download endpoint. The DevAuthHttpHandler can't
    /// inject the JWT on an <c>&lt;a href&gt;</c>-driven navigation (no DesignerApiClient
    /// roundtrip), so for the sender path we use the <i>recipient</i> download URL — the
    /// per-recipient access token in the URL is the auth — and grab the first recipient's
    /// token. Single-signer workflows (the typical demo case) have exactly one anyway.
    /// </summary>
    private string SignedDocumentUrl(Guid requestId)
    {
        var apiBase = (Config["Stampd:Api:BaseUrl"] ?? "http://localhost:5070").TrimEnd('/');
        var request = _page?.Items.FirstOrDefault(r => r.Id == requestId);
        var recipient = request?.Recipients.FirstOrDefault();
        if (recipient?.AccessUrl is null)
        {
            return "#";
        }

        // recipient.AccessUrl is the UI signer page URL (per SigningUrlTemplate). The token
        // is the last path segment. Reuse it to hit the recipient signed-document endpoint
        // directly on the WebApi.
        var token = recipient.AccessUrl.Split('/')[^1];
        return $"{apiBase}/api/sign/{token}/signed-document";
    }

    private static string StatusChipClass(string status) => status switch
    {
        "Completed" => "stampd-chip--success",
        "Voided" or "Declined" or "Expired" => "stampd-chip--danger",
        _ => "stampd-chip--accent",
    };
}
