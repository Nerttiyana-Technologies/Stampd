@page "/designer/requests"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@inject DesignerApiClient Api
@inject IConfiguration Config
@inject IHostEnvironment HostEnv
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Signing requests — Stampd</PageTitle>

<div class="stampd-page">
    <section class="stampd-hero">
        <h1 class="stampd-hero-title">Signing requests</h1>
        <p class="stampd-hero-sub">
            Workflows you've dispatched. Once every recipient signs, the signed PDF is sealed
            and downloadable here. Newest first.
        </p>
    </section>

    @if (!AutoAuth)
    {
        <DesignerAuthBar @ref="_authBar" OnTokenChanged="OnTokenChanged" />
    }

    <!-- v2.0 Slice B — collapsible filter panel. Closed by default so the page looks
         the same as v1.3 on first load; opens on click to reveal the status chip
         group, sender/recipient text inputs, date range, and sort selector. -->
    <section class="stampd-card" style="padding:0.85rem 1.1rem;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
            <button type="button"
                    class="stampd-btn stampd-btn--ghost"
                    style="padding:0.35rem 0.85rem; font-size:0.86rem;"
                    @onclick="() => _filtersOpen = !_filtersOpen">
                @(_filtersOpen ? "▾" : "▸") Filters
                @if (HasActiveFilters)
                {
                    <span class="stampd-chip stampd-chip--accent" style="margin-left:0.5rem; font-size:0.7rem;">Active</span>
                }
            </button>
            <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.84rem; color: var(--stampd-muted);">
                <label for="sort-select">Sort by</label>
                <select id="sort-select"
                        class="stampd-auth-input"
                        style="width:auto; padding:0.3rem 0.5rem; font-size:0.84rem;"
                        value="@($"{_sortBy}|{_direction}")"
                        @onchange="OnSortChangedAsync">
                    @foreach (var opt in SortOptions)
                    {
                        <option value="@($"{opt.Value}|desc")">@opt.Label (newest first)</option>
                        <option value="@($"{opt.Value}|asc")">@opt.Label (oldest first)</option>
                    }
                </select>
            </div>
        </div>

        @if (_filtersOpen)
        {
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem; margin-top:1rem; padding-top:0.85rem; border-top:1px solid var(--stampd-border);">
                <!-- Status chips -->
                <div style="grid-column: 1 / -1;">
                    <div class="signer-field-label">Status</div>
                    <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-top:0.3rem;">
                        @foreach (var status in StatusOptions)
                        {
                            var active = _selectedStatuses.Contains(status);
                            <button type="button"
                                    class="stampd-chip @(active ? "stampd-chip--accent" : "")"
                                    style="cursor:pointer; border:1px solid var(--stampd-border); padding:0.25rem 0.65rem;"
                                    @onclick="() => ToggleStatusAsync(status)">
                                @status
                            </button>
                        }
                    </div>
                </div>

                <!-- Sender / Recipient text inputs -->
                <div>
                    <label class="signer-field-label" for="sender-filter">Sender email</label>
                    <input id="sender-filter"
                           class="stampd-auth-input"
                           type="email"
                           placeholder="sender@example.com"
                           @bind="_senderEmailFilter"
                           @bind:event="oninput"
                           @onblur="ApplyFiltersAsync" />
                </div>
                <div>
                    <label class="signer-field-label" for="recipient-filter">Recipient email</label>
                    <input id="recipient-filter"
                           class="stampd-auth-input"
                           type="email"
                           placeholder="alice@example.com"
                           @bind="_recipientEmailFilter"
                           @bind:event="oninput"
                           @onblur="ApplyFiltersAsync" />
                </div>

                <!-- Dispatched date range -->
                <div>
                    <label class="signer-field-label" for="dispatched-from">Dispatched from</label>
                    <input id="dispatched-from"
                           class="stampd-auth-input"
                           type="date"
                           @bind="_dispatchedFromFilter"
                           @onblur="ApplyFiltersAsync" />
                </div>
                <div>
                    <label class="signer-field-label" for="dispatched-to">Dispatched to</label>
                    <input id="dispatched-to"
                           class="stampd-auth-input"
                           type="date"
                           @bind="_dispatchedToFilter"
                           @onblur="ApplyFiltersAsync" />
                </div>

                <!-- Action row -->
                <div style="grid-column: 1 / -1; display:flex; gap:0.5rem; justify-content:flex-end; margin-top:0.25rem;">
                    @if (HasActiveFilters)
                    {
                        <button type="button"
                                class="stampd-btn stampd-btn--ghost"
                                @onclick="ClearFiltersAsync">
                            Clear filters
                        </button>
                    }
                    <button type="button"
                            class="stampd-btn stampd-btn--primary"
                            @onclick="ApplyFiltersAsync">
                        Apply
                    </button>
                </div>
            </div>
        }
    </section>

    <section class="stampd-card">
        @if (_loading)
        {
            <p class="stampd-page-subtitle">Loading…</p>
        }
        else if (!AutoAuth && string.IsNullOrEmpty(_token))
        {
            <p class="stampd-page-subtitle">Enter a JWT bearer token above to list signing requests.</p>
        }
        else if (_page is null)
        {
            <div class="signer-error">Failed to load signing requests.</div>
        }
        else if (_page.Items.Count == 0)
        {
            <p class="stampd-page-subtitle">
                @if (HasActiveFilters)
                {
                    <text>No signing requests match the current filters. </text>
                    <button type="button"
                            class="stampd-btn stampd-btn--ghost"
                            style="padding:0.25rem 0.6rem; font-size:0.82rem; margin-left:0.5rem;"
                            @onclick="ClearFiltersAsync">
                        Clear filters
                    </button>
                }
                else
                {
                    <text>
                        No signing requests yet. Open a template in the
                        <a href="/designer">designer</a> and click <strong>Send</strong> to dispatch one.
                    </text>
                }
            </p>
        }
        else
        {
            <div class="stampd-template-table">
                <div class="stampd-request-row stampd-template-head" style="@(IsAdmin ? "grid-template-columns: 36px 2fr 1.5fr 1fr 1.2fr auto;" : "")">
                    @if (IsAdmin)
                    {
                        <div style="display:flex; align-items:center; justify-content:center;">
                            <input type="checkbox"
                                   aria-label="Select all on this page"
                                   checked="@AllVisibleSelected"
                                   @onchange="OnToggleAllVisible" />
                        </div>
                    }
                    <div>Subject / Template</div>
                    <div>Recipient</div>
                    <div>Status</div>
                    <div>Dispatched</div>
                    <div>Signed PDF</div>
                </div>
                @foreach (var r in _page.Items)
                {
                    var firstRecipient = r.Recipients.FirstOrDefault();
                    var isCompleted = string.Equals(r.Status, "Completed", StringComparison.OrdinalIgnoreCase);
                    <div class="stampd-request-row" style="@(IsAdmin ? "grid-template-columns: 36px 2fr 1.5fr 1fr 1.2fr auto;" : "")">
                        @if (IsAdmin)
                        {
                            var requestId = r.Id;
                            <div style="display:flex; align-items:center; justify-content:center;">
                                <input type="checkbox"
                                       aria-label="Select request"
                                       checked="@_selectedRequestIds.Contains(requestId)"
                                       @onchange="() => ToggleRequestSelection(requestId)" />
                            </div>
                        }
                        <div>
                            <div style="font-weight:600;">@r.Subject</div>
                            @if (!string.IsNullOrWhiteSpace(r.TemplateName))
                            {
                                <div style="font-size:0.82rem; color: var(--stampd-muted);">@r.TemplateName</div>
                            }
                        </div>
                        <div style="font-size:0.86rem;">
                            @if (firstRecipient is not null)
                            {
                                <div>@firstRecipient.Name</div>
                                <div style="font-size:0.78rem; color: var(--stampd-muted);">@firstRecipient.Email</div>
                            }
                            @if (r.Recipients.Count > 1)
                            {
                                <a href="@($"/designer/requests/{r.Id}")"
                                   style="font-size:0.75rem; color: var(--stampd-accent); margin-top:2px; display:inline-block; text-decoration:none;"
                                   title="See all @r.Recipients.Count recipients and their statuses">
                                    +@(r.Recipients.Count - 1) more → see all
                                </a>
                            }
                        </div>
                        <div>
                            <span class="stampd-chip @StatusChipClass(r.Status)">@r.Status</span>
                        </div>
                        <div style="font-size:0.85rem; color: var(--stampd-muted);">
                            @r.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        @* Compact icon-button row — keeps the action column tight so the
                           Dispatched column doesn't overflow. Title attributes carry the
                           full label for tooltip-on-hover. *@
                        <div style="display:flex; gap:0.35rem; justify-content:flex-end; align-items:center;">
                            <a class="stampd-icon-btn"
                               href="@($"/designer/requests/{r.Id}")"
                               aria-label="Details"
                               title="See per-recipient status, timestamps, and audit trail">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            </a>
                            @if (isCompleted)
                            {
                                <a class="stampd-icon-btn stampd-icon-btn--primary"
                                   href="@SignedDocumentUrl(r.Id)"
                                   target="_blank"
                                   rel="noopener"
                                   aria-label="Open signed PDF"
                                   title="Open the sealed PDF in a new tab">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                </a>
                            }
                            else if (firstRecipient?.AccessUrl is { } url)
                            {
                                <a class="stampd-icon-btn"
                                   href="@url"
                                   target="_blank"
                                   rel="noopener"
                                   aria-label="Recipient signing link"
                                   title="Open the recipient signing link">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                    </svg>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination footer (v1.3 #158) -->
            <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--stampd-border);">
                <div style="display:flex; align-items:center; gap:0.6rem; font-size:0.85rem; color: var(--stampd-muted);">
                    <span>@RowRangeLabel()</span>
                    <span style="opacity:0.5;">·</span>
                    <label for="page-size" style="font-size:0.85rem;">Per page</label>
                    <select id="page-size"
                            class="stampd-auth-input"
                            style="width:auto; padding:0.3rem 0.5rem; font-size:0.85rem;"
                            value="@_pageSize"
                            @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>

                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <button type="button"
                            class="stampd-btn stampd-btn--ghost"
                            disabled="@(_page.Page <= 1)"
                            @onclick="PrevPageAsync">
                        ← Previous
                    </button>
                    <span style="font-size:0.85rem; color: var(--stampd-muted); padding:0 0.5rem;">
                        Page <strong style="color: var(--stampd-fg);">@_page.Page</strong> of <strong style="color: var(--stampd-fg);">@_page.TotalPages</strong>
                    </span>
                    <button type="button"
                            class="stampd-btn stampd-btn--ghost"
                            disabled="@(_page.Page >= _page.TotalPages)"
                            @onclick="NextPageAsync">
                        Next →
                    </button>
                </div>
            </div>
        }
    </section>

    <!-- v2.0 Slice D — floating bulk-action bar. Renders only when an admin has at
         least one request selected. Position is fixed-bottom so the page can scroll
         beneath it without losing the action context. -->
    @if (IsAdmin && _selectedRequestIds.Count > 0)
    {
        <div style="position:fixed; bottom:1.25rem; left:50%; transform:translateX(-50%); background: var(--stampd-surface); border:1px solid var(--stampd-border); border-radius:12px; padding:0.75rem 1.1rem; box-shadow:0 6px 20px rgba(0,0,0,0.15); display:flex; align-items:center; gap:0.75rem; z-index:1000;">
            <span style="font-size:0.88rem; font-weight:600;">@_selectedRequestIds.Count selected</span>
            <button type="button"
                    class="stampd-btn stampd-btn--ghost"
                    @onclick="ClearBulkSelection">
                Clear
            </button>
            <button type="button"
                    class="stampd-btn"
                    style="background:#dc2626; color:white; border-color:#dc2626;"
                    disabled="@_bulkInFlight"
                    @onclick="StartBulkVoidAsync">
                @(_bulkInFlight ? "Voiding…" : "Void selected")
            </button>
            <button type="button"
                    class="stampd-btn stampd-btn--ghost"
                    disabled="@(_bulkInFlight || !AnyResendableSelected)"
                    title="@(AnyResendableSelected ? "Resend invitation to non-signed recipients on the selected requests" : "No selected request has recipients in Invited or Viewed state.")"
                    @onclick="StartBulkResendAsync">
                @(_bulkInFlight ? "Sending…" : "Resend invitation")
            </button>
        </div>
    }

    @if (_bulkResultMessage is not null)
    {
        <div style="position:fixed; bottom:5rem; left:50%; transform:translateX(-50%); padding:0.75rem 1rem; background: var(--stampd-surface-alt); border:1px solid var(--stampd-border); border-radius:8px; font-size:0.85rem; z-index:1000;">
            @_bulkResultMessage
        </div>
    }
</div>

@code {
    // Page-size choices kept narrow on purpose — 10/25/50/100 covers scanability through
    // power use without offering a footgun (the API caps at 200 regardless).
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private DesignerAuthBar? _authBar;
    private string _token = string.Empty;
    private SigningRequestListPage? _page;
    private int _pageNumber = 1;
    private int _pageSize = 25;
    private bool _loading;

    // v2.0 Slice B — filter state. Each field corresponds to one UI control in the
    // collapsible filter panel. ApplyFilter() builds a SigningRequestListFilter from
    // these fields and resets to page 1 (so a filter change never lands on a
    // phantom page).
    private bool _filtersOpen;                    // collapsible drawer state
    private readonly HashSet<string> _selectedStatuses = new(StringComparer.Ordinal);
    private string _senderEmailFilter = string.Empty;
    private string _recipientEmailFilter = string.Empty;
    private DateTime? _dispatchedFromFilter;
    private DateTime? _dispatchedToFilter;
    private string _sortBy = "dispatched";
    private string _direction = "desc";

    // v2.0 Slice D — bulk-action state (admin only). _selectedRequestIds tracks the
    // checkbox state across pagination; we deliberately persist the set when the user
    // pages so multi-page selections work. _bulkInFlight gates the action buttons
    // during the API call. _bulkResultMessage shows a transient toast-like notice
    // after the bulk op completes.
    private readonly HashSet<Guid> _selectedRequestIds = new();
    private bool _bulkInFlight;
    private string? _bulkResultMessage;

    private bool IsAdmin => CurrentUser.IsInRole(Core.Authorization.StampdRoles.Admin);

    private bool AllVisibleSelected =>
        _page is { Items.Count: > 0 } && _page.Items.All(r => _selectedRequestIds.Contains(r.Id));

    /// <summary>True when at least one selected request has a recipient with an active access URL.</summary>
    private bool AnyResendableSelected =>
        _page is not null
        && _page.Items.Any(r => _selectedRequestIds.Contains(r.Id)
            && r.Recipients.Any(rc => !string.IsNullOrWhiteSpace(rc.AccessUrl)));

    // Status options exposed to the filter UI. Mirror of the WebApi enum names —
    // case-sensitive on the wire because the API uses Enum.TryParse with ignoreCase
    // for tolerance, but the chip group needs canonical names to dedupe.
    private static readonly string[] StatusOptions =
    [
        "Pending", "Sent", "InProgress", "Completed", "Voided", "Declined", "Expired",
    ];

    private static readonly (string Value, string Label)[] SortOptions =
    [
        ("dispatched", "Dispatched date"),
        ("completed", "Completed date"),
        ("status", "Status"),
        ("subject", "Subject"),
    ];

    private bool AutoAuth => HostEnv.IsDevelopment();

    // v2.1 #196 — URL query-string sync. We mirror the live filter / sort / page state
    // into the URL so admins can copy a link out of the address bar and share it, and
    // so the browser back button restores the previous state instead of falling off
    // the page. `_suppressUriPush` guards against the LocationChanged → handler →
    // SyncToUri loop on programmatic NavigateTo.
    private bool _suppressUriPush;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        RestoreFromUri(Nav.Uri);
        if (AutoAuth)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    /// <summary>
    /// Reacts to back/forward navigation (and any external Nav.NavigateTo). Re-parses
    /// the new URL and refetches so the page reflects the address-bar truth.
    /// </summary>
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Avoid re-entry: the same handler will fire again when we call SyncToUri.
        if (_suppressUriPush) return;

        RestoreFromUri(e.Location);
        await InvokeAsync(async () =>
        {
            // Only refetch when we'd have refetched normally — in production
            // mode without a JWT token, LoadAsync would just no-op anyway and
            // we'd flash the unauth state. Mirror the OnInitializedAsync guard.
            if (AutoAuth || !string.IsNullOrEmpty(_token))
            {
                await LoadAsync();
            }
            StateHasChanged();
        });
    }

    /// <summary>
    /// Parse the current URL's query string into the filter / sort / page fields.
    /// Tolerant of missing or malformed parameters — anything we can't make sense
    /// of falls back to its default rather than throwing.
    /// </summary>
    private void RestoreFromUri(string uri)
    {
        var query = new Uri(uri).Query;
        var qs = QueryHelpers.ParseQuery(query);

        _selectedStatuses.Clear();
        if (qs.TryGetValue("status", out var statusValues))
        {
            foreach (var raw in statusValues)
            {
                if (string.IsNullOrEmpty(raw)) continue;
                foreach (var item in raw.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    _selectedStatuses.Add(item.Trim());
                }
            }
        }

        _senderEmailFilter = qs.TryGetValue("sender", out var sender) ? sender.ToString() : string.Empty;
        _recipientEmailFilter = qs.TryGetValue("recipient", out var recipient) ? recipient.ToString() : string.Empty;
        _dispatchedFromFilter = TryParseDate(qs, "from");
        _dispatchedToFilter = TryParseDate(qs, "to");
        _sortBy = qs.TryGetValue("sort", out var sort) && !StringValues.IsNullOrEmpty(sort)
            ? sort.ToString()
            : "dispatched";
        _direction = qs.TryGetValue("dir", out var dir) && !StringValues.IsNullOrEmpty(dir)
            ? dir.ToString()
            : "desc";
        _pageNumber = qs.TryGetValue("page", out var page) && int.TryParse(page, out var p) && p > 0 ? p : 1;
        _pageSize = qs.TryGetValue("size", out var size) && int.TryParse(size, out var s) && s > 0 ? s : 25;

        // Open the filter drawer if any filter is active so the user can see why
        // the list looks restricted (e.g. shared-URL recipient lands here).
        if (HasActiveFilters) _filtersOpen = true;
    }

    private static DateTime? TryParseDate(Dictionary<string, StringValues> qs, string key)
    {
        if (!qs.TryGetValue(key, out var raw) || StringValues.IsNullOrEmpty(raw)) return null;
        return DateTime.TryParse(raw.ToString(), System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
            out var dt) ? dt : null;
    }

    /// <summary>
    /// Push the current filter / sort / page state to the URL. Only non-default
    /// values become query parameters so the URL stays compact in the common
    /// "no filters" case. Pass <c>replace: true</c> on rapid changes (text-input
    /// blur) to avoid filling history with intermediate states.
    /// </summary>
    private void SyncToUri(bool replace = false)
    {
        var parameters = new Dictionary<string, object?>();
        if (_selectedStatuses.Count > 0)
            parameters["status"] = string.Join(",", _selectedStatuses.OrderBy(s => s, StringComparer.Ordinal));
        if (!string.IsNullOrWhiteSpace(_senderEmailFilter))
            parameters["sender"] = _senderEmailFilter.Trim();
        if (!string.IsNullOrWhiteSpace(_recipientEmailFilter))
            parameters["recipient"] = _recipientEmailFilter.Trim();
        if (_dispatchedFromFilter is { } from)
            parameters["from"] = from.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        if (_dispatchedToFilter is { } to)
            parameters["to"] = to.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        if (!string.Equals(_sortBy, "dispatched", StringComparison.Ordinal))
            parameters["sort"] = _sortBy;
        if (!string.Equals(_direction, "desc", StringComparison.Ordinal))
            parameters["dir"] = _direction;
        if (_pageNumber > 1)
            parameters["page"] = _pageNumber;
        if (_pageSize != 25)
            parameters["size"] = _pageSize;

        var newUri = Nav.GetUriWithQueryParameters(parameters);
        if (string.Equals(newUri, Nav.Uri, StringComparison.Ordinal)) return;

        // Programmatic NavigateTo will fire LocationChanged. We've already updated
        // the state from the live UI, and we're about to call LoadAsync ourselves,
        // so suppress the handler's RestoreFromUri + LoadAsync to avoid the
        // double-fetch.
        _suppressUriPush = true;
        try
        {
            Nav.NavigateTo(newUri, forceLoad: false, replace: replace);
        }
        finally
        {
            _suppressUriPush = false;
        }
    }

    private async Task OnTokenChanged(string token)
    {
        _token = token;
        if (string.IsNullOrEmpty(token))
        {
            _page = null;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _page = await Api.ListSigningRequestsAsync(
                _token,
                _pageNumber,
                _pageSize,
                BuildFilter(),
                CancellationToken.None);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Snapshots the current filter UI state into a request DTO. Empty/default
    /// fields stay null so the API URL stays compact when no filter is active.
    /// </summary>
    private SigningRequestListFilter BuildFilter() => new(
        Status: _selectedStatuses.Count > 0 ? _selectedStatuses.ToList() : null,
        TemplateId: null,
        SenderEmail: string.IsNullOrWhiteSpace(_senderEmailFilter) ? null : _senderEmailFilter.Trim(),
        RecipientEmail: string.IsNullOrWhiteSpace(_recipientEmailFilter) ? null : _recipientEmailFilter.Trim(),
        DispatchedFrom: _dispatchedFromFilter is { } from
            ? new DateTimeOffset(DateTime.SpecifyKind(from, DateTimeKind.Utc))
            : null,
        DispatchedTo: _dispatchedToFilter is { } to
            ? new DateTimeOffset(DateTime.SpecifyKind(to, DateTimeKind.Utc))
            : null,
        SortBy: _sortBy,
        Direction: _direction);

    /// <summary>
    /// Toggles a status in the multi-select chip group, resets to page 1, refetches,
    /// and mirrors the new state into the URL.
    /// </summary>
    private async Task ToggleStatusAsync(string status)
    {
        if (!_selectedStatuses.Add(status))
        {
            _selectedStatuses.Remove(status);
        }
        _pageNumber = 1;
        SyncToUri();
        await LoadAsync();
    }

    /// <summary>Sort-selector change → reset to page 1, refetch, push to URL.</summary>
    private async Task OnSortChangedAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "dispatched";
        // Format is "sortBy|direction" (e.g. "completed|asc") — single-select picker
        // packs both into one option so the user gets one click instead of two.
        var parts = raw.Split('|', 2);
        _sortBy = parts[0];
        _direction = parts.Length == 2 ? parts[1] : "desc";
        _pageNumber = 1;
        SyncToUri();
        await LoadAsync();
    }

    /// <summary>
    /// Apply text/date filters (called on input blur or Apply button). We use
    /// <c>replace: true</c> here so successive keystroke-blur events don't fill
    /// browser history with intermediate filter states — only the final value lands.
    /// </summary>
    private async Task ApplyFiltersAsync()
    {
        _pageNumber = 1;
        SyncToUri(replace: true);
        await LoadAsync();
    }

    /// <summary>Reset every filter field back to defaults, refetch, push to URL.</summary>
    private async Task ClearFiltersAsync()
    {
        _selectedStatuses.Clear();
        _senderEmailFilter = string.Empty;
        _recipientEmailFilter = string.Empty;
        _dispatchedFromFilter = null;
        _dispatchedToFilter = null;
        _sortBy = "dispatched";
        _direction = "desc";
        _pageNumber = 1;
        SyncToUri();
        await LoadAsync();
    }

    /// <summary>True when at least one filter is active — drives the "active filter" badge.</summary>
    private bool HasActiveFilters =>
        _selectedStatuses.Count > 0
        || !string.IsNullOrWhiteSpace(_senderEmailFilter)
        || !string.IsNullOrWhiteSpace(_recipientEmailFilter)
        || _dispatchedFromFilter is not null
        || _dispatchedToFilter is not null;

    private async Task PrevPageAsync()
    {
        if (_page is null || _page.Page <= 1) return;
        _pageNumber = _page.Page - 1;
        SyncToUri();
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page is null || _page.Page >= _page.TotalPages) return;
        _pageNumber = _page.Page + 1;
        SyncToUri();
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newSize) || newSize <= 0) return;
        // Reset to page 1 when the window size changes — otherwise asking for page 8
        // at 100/page lands on a phantom page when you switch down to 10/page.
        _pageSize = newSize;
        _pageNumber = 1;
        SyncToUri();
        await LoadAsync();
    }

    private string RowRangeLabel()
    {
        if (_page is null || _page.Total == 0) return "No results";
        var first = ((_page.Page - 1) * _page.PageSize) + 1;
        var last = Math.Min(first + _page.Items.Count - 1, _page.Total);
        return $"Showing {first}–{last} of {_page.Total}";
    }

    /// <summary>
    /// Composes the URL for the management download endpoint. The DevAuthHttpHandler can't
    /// inject the JWT on an <c>&lt;a href&gt;</c>-driven navigation (no DesignerApiClient
    /// roundtrip), so for the sender path we use the <i>recipient</i> download URL — the
    /// per-recipient access token in the URL is the auth — and grab the first recipient's
    /// token. Single-signer workflows (the typical demo case) have exactly one anyway.
    /// </summary>
    private string SignedDocumentUrl(Guid requestId)
    {
        var apiBase = (Config["Stampd:Api:BaseUrl"] ?? "http://localhost:5070").TrimEnd('/');
        var request = _page?.Items.FirstOrDefault(r => r.Id == requestId);
        var recipient = request?.Recipients.FirstOrDefault();
        if (recipient?.AccessUrl is null)
        {
            return "#";
        }

        // recipient.AccessUrl is the UI signer page URL (per SigningUrlTemplate). The token
        // is the last path segment. Reuse it to hit the recipient signed-document endpoint
        // directly on the WebApi.
        var token = recipient.AccessUrl.Split('/')[^1];
        return $"{apiBase}/api/sign/{token}/signed-document";
    }

    private static string StatusChipClass(string status) => status switch
    {
        "Completed" => "stampd-chip--success",
        "Voided" or "Declined" or "Expired" => "stampd-chip--danger",
        _ => "stampd-chip--accent",
    };

    // ---- v2.0 Slice D bulk-action handlers ----

    private void ToggleRequestSelection(Guid id)
    {
        if (!_selectedRequestIds.Add(id))
        {
            _selectedRequestIds.Remove(id);
        }
    }

    private void OnToggleAllVisible(ChangeEventArgs e)
    {
        if (_page is null) return;
        var checkedNow = e.Value is bool b && b;
        foreach (var item in _page.Items)
        {
            if (checkedNow) _selectedRequestIds.Add(item.Id);
            else _selectedRequestIds.Remove(item.Id);
        }
    }

    private void ClearBulkSelection()
    {
        _selectedRequestIds.Clear();
        _bulkResultMessage = null;
    }

    private async Task StartBulkVoidAsync()
    {
        if (_selectedRequestIds.Count == 0) return;

        _bulkInFlight = true;
        _bulkResultMessage = null;
        try
        {
            var ids = _selectedRequestIds.ToList();
            var result = await Api.BulkVoidAsync(string.Empty, ids, reason: "Voided in bulk by admin", CancellationToken.None);
            if (result is null)
            {
                _bulkResultMessage = "Bulk void rejected by the API (HTTP error).";
                return;
            }
            _bulkResultMessage = $"Voided {result.Succeeded}/{result.Succeeded + result.Failed} requests.";
            _selectedRequestIds.Clear();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _bulkResultMessage = ex.Message;
        }
        finally
        {
            _bulkInFlight = false;
        }
    }

    private async Task StartBulkResendAsync()
    {
        if (_selectedRequestIds.Count == 0 || _page is null) return;

        // Collect every recipient id with an active access URL across the selected
        // requests — those are the ones the workflow's ResendInvitationAsync accepts
        // (Invited or Viewed state). Recipients who've already signed are filtered
        // out client-side so the API doesn't waste cycles on them.
        var recipientIds = _page.Items
            .Where(r => _selectedRequestIds.Contains(r.Id))
            .SelectMany(r => r.Recipients
                .Where(rc => !string.IsNullOrWhiteSpace(rc.AccessUrl))
                .Select(rc => rc.Id))
            .Distinct()
            .ToList();

        if (recipientIds.Count == 0)
        {
            _bulkResultMessage = "Selected requests have no resend-eligible recipients.";
            return;
        }

        _bulkInFlight = true;
        _bulkResultMessage = null;
        try
        {
            var result = await Api.BulkResendAsync(string.Empty, recipientIds, CancellationToken.None);
            if (result is null)
            {
                _bulkResultMessage = "Bulk resend rejected by the API (HTTP error).";
                return;
            }
            _bulkResultMessage = $"Resent invitations to {result.Succeeded}/{result.Succeeded + result.Failed} recipients.";
        }
        catch (Exception ex)
        {
            _bulkResultMessage = ex.Message;
        }
        finally
        {
            _bulkInFlight = false;
        }
    }
}
