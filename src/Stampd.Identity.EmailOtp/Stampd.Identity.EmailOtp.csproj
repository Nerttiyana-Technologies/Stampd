<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Identity.EmailOtp</PackageId>
    <Description>Email one-time-password IIdentityVerificationProvider. Generates a 6-digit code, emails it via IEmailSender, verifies on submission. The default in-memory challenge store is for dev/single-node; production hosts should swap in a DB-backed IOtpChallengeStore.</Description>
    <PackageTags>stampd;identity;otp;email-otp;identity-verification</PackageTags>
    <RootNamespace>Stampd.Identity.EmailOtp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.301" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
