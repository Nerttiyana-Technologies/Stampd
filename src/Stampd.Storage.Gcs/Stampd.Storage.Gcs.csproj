<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Storage.Gcs</PackageId>
    <Description>Google Cloud Storage-backed IDocumentStorageProvider. Auth via Application Default Credentials (workload identity, service-account file, gcloud).</Description>
    <PackageTags>stampd;storage;google-cloud-storage;gcs;document-storage</PackageTags>
    <RootNamespace>Stampd.Storage.Gcs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
