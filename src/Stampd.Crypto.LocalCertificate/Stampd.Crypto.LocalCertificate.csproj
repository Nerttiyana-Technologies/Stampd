<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Crypto.LocalCertificate</PackageId>
    <Description>Local X.509 certificate ICryptographicSealingProvider for Stampd. Suitable for self-hosted production where the signing certificate is stored on disk or in the OS certificate store.</Description>
    <PackageTags>stampd;x509;certificate;sealing;pkcs12</PackageTags>
    <RootNamespace>Stampd.Crypto.LocalCertificate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />

    <!--
      BouncyCastle is referenced here so the local signer produces signature bytes that
      are byte-identical to what the engine's CMS pipeline expects. .NET's RSA.SignData
      *should* be equivalent for SHA-256-with-PKCS#1-v1.5, but in practice Adobe's
      verifier flagged the resulting CMS as invalid. Routing through BouncyCastle's
      RsaDigestSigner restores parity with the proven-working spike output.
    -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
