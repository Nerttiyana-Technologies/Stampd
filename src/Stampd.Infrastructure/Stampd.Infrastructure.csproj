<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Infrastructure</PackageId>
    <Description>EF Core DbContext, entity configurations, and provider-agnostic infrastructure for Stampd.</Description>
    <RootNamespace>Stampd.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core 9 is used while EF Core 10 stabilises. The DbContext targets only the public
      EF Core surface (no provider-specific calls), so a bump to EF 10 is a single version
      change here.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
