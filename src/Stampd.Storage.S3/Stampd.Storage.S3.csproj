<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Storage.S3</PackageId>
    <Description>AWS S3-backed IDocumentStorageProvider. Stores signed documents in an S3 bucket. Supports SSE-S3 (default), SSE-KMS via a configured KMS key, and per-tenant key prefixes.</Description>
    <PackageTags>stampd;storage;aws-s3;document-storage</PackageTags>
    <RootNamespace>Stampd.Storage.S3</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.24.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
