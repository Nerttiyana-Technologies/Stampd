<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Stampd.WebApi</RootNamespace>
    <UserSecretsId>stampd-webapi-dev</UserSecretsId>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
    <ProjectReference Include="..\Stampd.Engine\Stampd.Engine.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.LocalCertificate\Stampd.Crypto.LocalCertificate.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.Vault\Stampd.Crypto.Vault.csproj" />
    <ProjectReference Include="..\Stampd.Timestamp.FreeTsa\Stampd.Timestamp.FreeTsa.csproj" />
    <ProjectReference Include="..\Stampd.Infrastructure\Stampd.Infrastructure.csproj" />
    <ProjectReference Include="..\Stampd.Infrastructure.Sqlite\Stampd.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\Stampd.Storage.FileSystem\Stampd.Storage.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.OpenApi ships the native OpenAPI generator (the replacement for
      Swashbuckle) in .NET 9+. Pair with Scalar.AspNetCore for a polished docs UI.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />

    <!-- Structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Health checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />

    <!-- JWT auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
  </ItemGroup>

</Project>
