<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Stampd.Email.Smtp</PackageId>
    <Description>SMTP IEmailSender for Stampd, backed by MailKit. Works against any RFC 5321 SMTP server: in-process dev tools (Hermex), corporate Postfix/Exchange, hosted SMTP (SendGrid SMTP, SES SMTP, Mailgun, etc.).</Description>
    <PackageTags>stampd;email;smtp;mailkit</PackageTags>
    <RootNamespace>Stampd.Email.Smtp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
